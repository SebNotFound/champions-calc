<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Draw the floating bubble / calc panel over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Keep the overlay alive while the user plays (foreground service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Show the ongoing foreground-service notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional online extras (remote sprites). The calc itself runs offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_exo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExoOverlay">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Justification for the "specialUse" FGS type: a user-driven floating
                 overlay that hosts the calculator over the game. -->
            <property
                android:name="android:foregroundServiceTypeSpecialUse"
                android:value="floating_overlay_calculator" />
        </service>
    </application>
</manifest>
